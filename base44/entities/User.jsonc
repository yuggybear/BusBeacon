{
  "name": "User",
  "type": "object",
  "properties": {
    "app_role": {
      "type": "string",
      "enum": [
        "admin",
        "driver",
        "parent"
      ]
    },
    "school_name": {
      "type": "string"
    },
    "bus_id": {
      "type": "string"
    },
    "stop_id": {
      "type": "string"
    },
    "child_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "notify_proximity": {
      "type": "boolean",
      "default": true
    },
    "notify_approaching": {
      "type": "boolean",
      "default": true
    },
    "notify_arrived": {
      "type": "boolean",
      "default": true
    },
    "notify_broadcasts": {
      "type": "boolean",
      "default": true
    },
    "proximity_radius": {
      "type": "number",
      "default": 0.5,
      "title": "Proximity Alert Radius (km)"
    },
    "map_type": {
      "type": "string",
      "enum": [
        "street",
        "satellite"
      ],
      "default": "street"
    },
    "map_follow": {
      "type": "boolean",
      "default": true
    },
    "is_main_admin": {
      "type": "boolean",
      "default": false
    },
    "admin_verified": {
      "type": "boolean",
      "default": false
    },
    "admin_document_url": {
      "type": "string",
      "title": "Admin Documentation URL"
    },
    "admin_verification_status": {
      "type": "string",
      "enum": [
        "pending",
        "passed",
        "flagged",
        "failed"
      ],
      "default": "pending",
      "title": "AI Document Verification Status"
    },
    "admin_verification_score": {
      "type": "number",
      "title": "AI Verification Authenticity Score (0-100)"
    },
    "admin_verification_summary": {
      "type": "string",
      "title": "AI Verification Summary"
    },
    "admin_verification_details": {
      "type": "string",
      "title": "AI Verification Details (JSON)"
    }
  }
}