{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "bus_id": {
      "type": "string",
      "title": "Bus ID"
    },
    "author_name": {
      "type": "string",
      "title": "Author Name"
    },
    "message": {
      "type": "string",
      "title": "Message"
    }
  },
  "required": [
    "bus_id",
    "author_name",
    "message"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.bus_id": "{{user.data.bus_id}}"
        },
        {
          "user_condition": {
            "data.app_role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.bus_id": "{{user.data.bus_id}}"
        },
        {
          "user_condition": {
            "data.app_role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "data.app_role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "data.app_role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}